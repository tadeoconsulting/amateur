{
  "name": "app",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "postinstall": "prisma generate",
    "db:generate": "prisma generate",
    "db:push": "prisma db push",
    "db:nueva-migracion": "node scripts/nueva-migracion.mjs",
    "db:aplicar-migraciones": "prisma migrate deploy",
    "db:deriva": "prisma migrate diff --from-url \"$DIRECT_URL\" --to-schema-datamodel prisma/schema.prisma --exit-code",
    "lint:ci": "node scripts/comprobar-lint.mjs",
    "db:seed": "npx tsx prisma/seed.ts",
    "db:studio": "prisma studio",
    "db:reset": "prisma migrate reset",
    "db:make-admin": "npx tsx prisma/make-admin.ts",
    "db:remove-admin": "npx tsx prisma/remove-admin.ts",
    "db:backfill-slugs": "npx tsx prisma/backfill-slugs.ts",
    "db:cargar-jugadores": "npx tsx prisma/cargar-jugadores.ts",
    "test:auth": "node --test tests/*.test.mjs",
    "test:unit": "node --test tests/unit/*.test.mjs",
    "test:api": "node --test tests/*.test.mjs"
  },
  "prisma": {
    "seed": "npx tsx prisma/seed.ts"
  },
  "dependencies": {
    "@prisma/client": "^5.22.0",
    "@vercel/blob": "^2.8.1",
    "ably": "^2.29.0",
    "bcryptjs": "^3.0.3",
    "jose": "^6.2.12",
    "next": "16.4.0",
    "prisma": "^5.22.0",
    "react": "19.3.0",
    "react-dom": "19.3.0"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4",
    "@types/node": "^20",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "eslint": "^9",
    "eslint-config-next": "16.4.0",
    "tailwindcss": "^4",
    "tsx": "^4.23.15",
    "typescript": "^5"
  }
}
