generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

// ─── Identity & Roles ───────────────────────────────────────────

enum Role {
  ADMIN
  ORGANIZADOR
  CLUB_OWNER
  JUGADOR
  SPONSOR
  FAN
  // Quien gestiona el partido en vivo de los torneos que se le asignan, solo en los días de juego
  // (especificación 011). Es solo mesa: no comparte perfil con ningún otro.
  MESA
}

model User {
  id            String    @id @default(cuid())
  email         String    @unique
  passwordHash  String
  firstName     String
  lastName      String
  dni           String?
  phone         String?
  avatarUrl     String?
  department    String?
  birthDate     DateTime?
  gender        String?
  organization  String?
  // Primer tramo de la URL pública de sus torneos (cupamateur.com/{organizerSlug}/{slug}). Se
  // asigna al crear su primer torneo, a partir de la organización (o de su nombre), y después no
  // cambia aunque se edite el perfil: los links ya compartidos no se rompen. Ver _lib/slug.ts.
  organizerSlug String?   @unique
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  roles                         UserRole[]
  ownedClubs                    Club[]                 @relation("ClubOwner")
  // Un jugador puede estar en varios clubes: una ficha (PlayerProfile) por club, más a lo sumo una
  // "libre" (clubId null: solo tiene posición, todavía sin equipo). Ver _lib/player-clubs.ts.
  playerProfiles                PlayerProfile[]
  // Con qué equipo "sale a la cancha" hoy: el que muestra la pestaña Actividad. Es un id de club
  // sin relación a propósito: si ya no es de sus equipos, se ignora y se usa el primero.
  activeClubId                  String?
  tournaments                   Tournament[]           @relation("TournamentOrganizer")
  seasons                       Season[]
  staffRoles                    StaffMember[]
  invitations                   PlayerInvitation[]
  staffInvitations              StaffInvitation[]
  tournamentRequests            TournamentRequest[]
  sedes                         Sede[]
  joinRequests                  PlayerJoinRequest[]
  passwordResetTokens           PasswordResetToken[]
  // Invitaciones a reclamar un perfil provisional (especificación 009): las que envió (un admin) y las que aceptó.
  profileInvitationsSent        ProfileInvitation[]    @relation("ProfileInvitationInviter")
  profileInvitationsAccepted    ProfileInvitation[]    @relation("ProfileInvitationAcceptedBy")
  mesaAssignments               TournamentMesa[]       @relation("MesaUser")
  mesaAssignmentsMade           TournamentMesa[]       @relation("MesaAssignedBy")
  eventsRecorded                MatchEvent[]           @relation("EventRecordedBy")
  delegateInvitationsSent       DelegateInvitation[]   @relation("DelegateInvitationInviter")
  delegateInvitationsAccepted   DelegateInvitation[]   @relation("DelegateInvitationAcceptedBy")
  // Co-delegados (especificación 014): el equipo del que es co-delegado (a lo sumo uno), a quiénes sumó y las invitaciones.
  coDelegateOf                  ClubDelegate?          @relation("ClubDelegateUser")
  coDelegatesAdded              ClubDelegate[]         @relation("ClubDelegateInviter")
  coDelegateInvitationsSent     CoDelegateInvitation[] @relation("CoDelegateInvitationInviter")
  coDelegateInvitationsAccepted CoDelegateInvitation[] @relation("CoDelegateInvitationAcceptedBy")
}

// Un enlace de "Olvidé mi contraseña" (se manda por correo). Se guarda el hash del token, no el
// token: quien lea la base no puede armar un enlace válido. Vale una hora y una sola vez.
model PasswordResetToken {
  id        String    @id @default(cuid())
  userId    String
  tokenHash String    @unique
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

// Una dirección guardada por el organizador para reutilizar entre torneos (decisión 10:
// hoy Tournament.location sigue siendo texto libre — esto no lo reemplaza, solo evita
// tener que volver a escribirlo cada vez. Ver /ajustes/sedes y el asistente "Crear torneo").
model Sede {
  id          String   @id @default(cuid())
  organizerId String
  name        String
  city        String?
  address     String?
  reference   String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  organizer User @relation(fields: [organizerId], references: [id], onDelete: Cascade)

  @@index([organizerId])
}

model UserRole {
  id     String @id @default(cuid())
  userId String
  role   Role

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, role])
}

// ─── Clubs & Teams ──────────────────────────────────────────────

model Club {
  id             String   @id @default(cuid())
  name           String
  shortName      String
  logoUrl        String?
  color          String?
  delegadoNombre String?
  delegadoTel    String?
  delegadoEmail  String?
  ownerId        String
  // Equipo temporal creado por un organizador para su torneo (sin delegado ni
  // métricas). No aparece en la búsqueda de equipos de la comunidad.
  isTemporary    Boolean  @default(false)
  // Link para compartir por WhatsApp: quien lo abre puede unirse al club como jugador.
  // Es un secreto: se puede revocar generando uno nuevo. null = todavía no se generó.
  inviteToken    String?  @unique
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  owner                 User                   @relation("ClubOwner", fields: [ownerId], references: [id])
  categories            TeamCategory[]
  staffMembers          StaffMember[]
  players               PlayerProfile[]
  homeMatches           Match[]                @relation("HomeTeam")
  awayMatches           Match[]                @relation("AwayTeam")
  enrollments           TournamentTeam[]
  invitations           PlayerInvitation[]
  staffInvitations      StaffInvitation[]
  tournamentRequests    TournamentRequest[]
  lineups               MatchLineup[]
  joinRequests          PlayerJoinRequest[]
  delegateInvitations   DelegateInvitation[]
  // Co-delegados (especificación 014): otras personas que gestionan el equipo junto al dueño.
  coDelegates           ClubDelegate[]
  coDelegateInvitations CoDelegateInvitation[]
  // Gestión del club (especificación 015). Viven en tablas aparte, no como columnas del club, para que ninguna ruta que
  // devuelve el club entero (hay varias, y una es pública) pueda filtrar cuotas.
  feeSettings           ClubFeeSettings?
  fees                  MemberFee[]
  // Entrenamientos (especificación 015, entrega 2): lugares, horarios semanales, sesiones y asistencia.
  trainingPlaces        TrainingPlace[]
  trainingSchedules     TrainingSchedule[]
  trainingSessions      TrainingSession[]

  @@index([ownerId])
}

model TeamCategory {
  id        String   @id @default(cuid())
  name      String
  gender    String
  ageType   String?
  maxAge    Int?
  minAge    Int?
  clubId    String
  createdAt DateTime @default(now())

  club              Club               @relation(fields: [clubId], references: [id], onDelete: Cascade)
  players           PlayerProfile[]
  dtId              String?
  dt                StaffMember?       @relation(fields: [dtId], references: [id])
  trainingSchedules TrainingSchedule[]
  trainingSessions  TrainingSession[]

  @@index([clubId])
}

model StaffMember {
  id        String   @id @default(cuid())
  role      String
  userId    String
  clubId    String
  createdAt DateTime @default(now())

  user       User           @relation(fields: [userId], references: [id])
  club       Club           @relation(fields: [clubId], references: [id], onDelete: Cascade)
  categories TeamCategory[]

  @@unique([userId, clubId, role])
  @@index([clubId])
}

// Un co-delegado de un equipo (especificación 014): gestiona el club con los permisos del dueño (`Club.ownerId`), salvo
// eliminarlo, transferirlo, cambiar el contacto público y sumar o quitar a otros delegados. Hasta 3 por equipo (se
// comprueba en la API) y una persona lo es de un solo equipo (`userId` único).
model ClubDelegate {
  id          String   @id @default(cuid())
  clubId      String
  userId      String
  invitedById String
  createdAt   DateTime @default(now())

  club      Club @relation(fields: [clubId], references: [id], onDelete: Cascade)
  user      User @relation("ClubDelegateUser", fields: [userId], references: [id], onDelete: Cascade)
  invitedBy User @relation("ClubDelegateInviter", fields: [invitedById], references: [id], onDelete: Cascade)

  @@unique([clubId, userId])
  @@unique([userId])
  @@index([clubId])
}

// ─── Players ────────────────────────────────────────────────────

// La ficha de un jugador EN un club (dorsal, categoría, estadísticas por torneo). Un mismo usuario
// puede tener varias, una por club donde juega.
model PlayerProfile {
  id         String    @id @default(cuid())
  position   String?
  number     Int?
  // null = jugador provisional: cargado por un admin sin cuenta (especificación 009). Sus goles y
  // tarjetas cuelgan de este perfil, así que al asignarle una cuenta (se le pone el userId) no se
  // pierde nada. Un provisional solo está en un equipo; para estar en dos necesita cuenta.
  userId     String?
  clubId     String?
  categoryId String?
  status     String    @default("activo")
  // Datos propios del provisional (con cuenta, el nombre, DNI y fecha de nacimiento salen de User y
  // acá quedan en null). Nunca son públicos: solo el nombre y la posición se muestran. El DNI es
  // único entre provisionales: una misma persona no es dos provisionales.
  firstName  String?
  lastName   String?
  dni        String?   @unique
  birthDate  DateTime?
  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @updatedAt

  // Restrict a propósito: borrar una cuenta nunca deja una ficha huérfana sin nombre (parecería un provisional). El código borra
  // las fichas de la cuenta antes que la cuenta (delete-user.ts). Producción ya lo tenía así; el esquema decía SetNull por omisión.
  user            User?               @relation(fields: [userId], references: [id], onDelete: Restrict)
  club            Club?               @relation(fields: [clubId], references: [id])
  category        TeamCategory?       @relation(fields: [categoryId], references: [id])
  stats           PlayerStats[]
  matchEvents     MatchEvent[]        @relation("EventPlayer")
  // Los cambios en que este jugador entró (en un cambio, `playerId` es quien sale).
  substitutionsIn MatchEvent[]        @relation("SubstitutionIn")
  lineups         MatchLineup[]
  invitations     ProfileInvitation[]
  // Cuota propia y primer mes de cobro (especificación 015), en tablas aparte: la deuda de un jugador es privada.
  feeSetting      PlayerFeeSetting?
  fees            MemberFee[]
  attendances     Attendance[]

  // Una ficha por club (el clubId null — la ficha "libre" — queda fuera de esta regla en la base:
  // que haya una sola lo cuida _lib/player-clubs.ts).
  @@unique([userId, clubId])
  @@index([userId])
  @@index([clubId])
}

// Una invitación para que una persona reclame un perfil PROVISIONAL (especificación 009, entrega 3): la crea
// un admin, por correo o como enlace para compartir (email null), y vale 7 días. Quien la abre inicia sesión y
// confirma el DNI del perfil; si coincide, su cuenta queda vinculada. Un enlace sin correo lo protege solo
// el DNI, por eso los intentos fallidos se cuentan (`attempts`) y al llegar al límite se bloquea.
//   pending   vigente (si `expiresAt` ya pasó, está vencida)
//   review    la aceptó una cuenta que ya tenía ficha en ese equipo: un admin debe unir los perfiles
//   accepted  vinculada · cancelled  la cancelaron o la reemplazaron · locked  demasiados DNI equivocados
model ProfileInvitation {
  id           String    @id @default(cuid())
  profileId    String
  email        String?
  token        String    @unique
  status       String    @default("pending")
  attempts     Int       @default(0)
  invitedBy    String
  acceptedById String?
  acceptedAt   DateTime?
  expiresAt    DateTime
  createdAt    DateTime  @default(now())

  profile    PlayerProfile @relation(fields: [profileId], references: [id], onDelete: Cascade)
  inviter    User          @relation("ProfileInvitationInviter", fields: [invitedBy], references: [id], onDelete: Cascade)
  acceptedBy User?         @relation("ProfileInvitationAcceptedBy", fields: [acceptedById], references: [id], onDelete: SetNull)

  @@index([profileId])
}

// La mesa de un torneo (especificación 011): una cuenta con el perfil MESA a la que el organizador (o el admin)
// le asignó el torneo. Solo puede gestionar el partido en vivo de los torneos asignados y solo dentro de su
// ventana de acceso (el día de juego, de 1 h antes del primer partido a 1 h después del último).
model TournamentMesa {
  id           String   @id @default(cuid())
  tournamentId String
  userId       String
  assignedById String
  createdAt    DateTime @default(now())

  tournament Tournament @relation(fields: [tournamentId], references: [id], onDelete: Cascade)
  user       User       @relation("MesaUser", fields: [userId], references: [id], onDelete: Cascade)
  assignedBy User       @relation("MesaAssignedBy", fields: [assignedById], references: [id], onDelete: Cascade)

  @@unique([tournamentId, userId])
  @@index([userId])
}

// Invitación para que alguien pase a ser el delegado de un equipo temporal (especificación 009, entrega 4). Un
// enlace secreto (con o sin correo) que el admin crea y comparte; quien lo acepta con su cuenta queda como dueño del
// equipo, igual que con "Oficializar". Vale 7 días y se usa una vez.
//   pending  vigente (una que ya pasó su fecha está vencida)  ·  accepted  ya hay delegado
//   cancelled  la cancelaron o la reemplazaron
// Invitación para ser co-delegado de un equipo con delegado (especificación 014). Mismo patrón que `DelegateInvitation`
// (enlace secreto, 7 días, un solo uso), pero la crea el dueño del club o un admin y el equipo no es temporal.
//   pending  vigente (una que ya pasó su fecha está vencida)  ·  accepted  ya es co-delegado  ·  cancelled  la cancelaron
// Con correo, solo la acepta la cuenta con ese correo; sin correo, quien tenga el enlace.
model CoDelegateInvitation {
  id           String    @id @default(cuid())
  clubId       String
  email        String?
  token        String    @unique
  status       String    @default("pending")
  invitedById  String
  acceptedById String?
  acceptedAt   DateTime?
  expiresAt    DateTime
  createdAt    DateTime  @default(now())

  club       Club  @relation(fields: [clubId], references: [id], onDelete: Cascade)
  inviter    User  @relation("CoDelegateInvitationInviter", fields: [invitedById], references: [id], onDelete: Cascade)
  acceptedBy User? @relation("CoDelegateInvitationAcceptedBy", fields: [acceptedById], references: [id], onDelete: SetNull)

  @@index([clubId])
}

model DelegateInvitation {
  id           String    @id @default(cuid())
  clubId       String
  email        String?
  token        String    @unique
  status       String    @default("pending")
  invitedBy    String
  acceptedById String?
  acceptedAt   DateTime?
  expiresAt    DateTime
  createdAt    DateTime  @default(now())

  club       Club  @relation(fields: [clubId], references: [id], onDelete: Cascade)
  inviter    User  @relation("DelegateInvitationInviter", fields: [invitedBy], references: [id], onDelete: Cascade)
  acceptedBy User? @relation("DelegateInvitationAcceptedBy", fields: [acceptedById], references: [id], onDelete: SetNull)

  @@index([clubId])
}

model PlayerStats {
  id            String @id @default(cuid())
  playerId      String
  tournamentId  String
  goals         Int    @default(0)
  assists       Int    @default(0)
  yellowCards   Int    @default(0)
  redCards      Int    @default(0)
  matchesPlayed Int    @default(0)

  player     PlayerProfile @relation(fields: [playerId], references: [id], onDelete: Cascade)
  tournament Tournament    @relation(fields: [tournamentId], references: [id], onDelete: Cascade)

  @@unique([playerId, tournamentId])
  @@index([tournamentId])
}

model PlayerInvitation {
  id        String   @id @default(cuid())
  email     String
  clubId    String
  invitedBy String
  token     String   @unique @default(cuid())
  status    String   @default("pending")
  expiresAt DateTime
  createdAt DateTime @default(now())

  club    Club @relation(fields: [clubId], references: [id], onDelete: Cascade)
  inviter User @relation(fields: [invitedBy], references: [id])

  @@index([clubId])
}

// El sentido contrario a PlayerInvitation: acá es el jugador quien pide unirse a un club (lo
// encontró en "Buscar equipos"), y el club acepta o rechaza — no hace falta un token porque
// ya tiene cuenta. Una fila por (club, jugador): re-pedir después de un rechazo reusa la misma
// fila en vez de crear otra.
model PlayerJoinRequest {
  id         String    @id @default(cuid())
  clubId     String
  userId     String
  status     String    @default("pending") // pending | accepted | declined | cancelled
  createdAt  DateTime  @default(now())
  resolvedAt DateTime?

  club Club @relation(fields: [clubId], references: [id], onDelete: Cascade)
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([clubId, userId])
  @@index([userId, status])
}

// Invitación de un miembro de staff (delegado, asistente o DT) que todavía no tiene cuenta.
// Igual patrón que PlayerInvitation, pero un StaffMember no es exclusivo de un club: la
// misma persona puede aceptar invitaciones de varios clubes.
model StaffInvitation {
  id        String   @id @default(cuid())
  email     String
  clubId    String
  role      String
  invitedBy String
  token     String   @unique @default(cuid())
  status    String   @default("pending")
  expiresAt DateTime
  createdAt DateTime @default(now())

  club    Club @relation(fields: [clubId], references: [id], onDelete: Cascade)
  inviter User @relation(fields: [invitedBy], references: [id])

  @@index([clubId])
}

// ─── Tournaments ────────────────────────────────────────────────

model Tournament {
  id          String    @id @default(cuid())
  name        String
  format      String
  status      String    @default("draft")
  sportType   String    @default("futbol")
  maxTeams    Int
  minTeams    Int?
  startDate   DateTime
  endDate     DateTime?
  location    String
  category    String?
  // Foto del torneo (URL pública en Vercel Blob); la sube el organizador o el admin. null = sin foto.
  logoUrl     String?
  organizerId String
  // Segundo tramo de la URL pública (cupamateur.com/{organizerSlug}/{slug}): sale del nombre al
  // crear el torneo, con sufijo -2, -3... si el organizador ya tiene uno igual, y no cambia al
  // renombrarlo. Null en torneos anteriores hasta correr prisma/backfill-slugs.ts.
  slug        String?
  // Cuándo se eliminó. Un torneo eliminado se oculta en todas las pantallas y solo un admin lo ve
  // (en Admin → Torneos → Eliminados) para restaurarlo o eliminarlo definitivamente. Null = activo.
  deletedAt   DateTime?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  // Datos que pide el asistente "Crear torneo". Todos opcionales: los torneos
  // que ya existían no los tienen.
  modality        String? // "5 vs 5" ... "11 vs 11"
  gender          String? // "Femenino" | "Masculino" | "Mixto"
  minutesPerHalf  Int?
  playersPerTeam  Int?
  assignDelegates Boolean  @default(false)
  registrationFee String? // texto libre, ej. "S/100"
  refereeFee      String?
  rules           String[] @default([]) // condiciones / bases del torneo

  // Solo relevantes para eliminacion/copa/relampago (ver especificación 007).
  extraTimeMinutes      Int? // minutos de cada tiempo del tiempo extra; null = 15' por omisión
  groupsAdvancePerGroup Int? // solo "copa": cuántos pasan de cada grupo (2, 3 o 4); null = 2
  playoffTeams          Int? // solo "liga": cuántos de la tabla pasan a llaves (2, 4, 8 o 16); null = sin llaves

  // Temporada a la que pertenece (especificación 012) y en qué etapa: "apertura" | "clausura" | "final".
  // Los dos null fuera de una temporada.
  seasonId    String?
  seasonStage String?

  organizer   User                @relation("TournamentOrganizer", fields: [organizerId], references: [id])
  season      Season?             @relation(fields: [seasonId], references: [id], onDelete: SetNull)
  teams       TournamentTeam[]
  requests    TournamentRequest[]
  matches     Match[]
  mesas       TournamentMesa[]
  playerStats PlayerStats[]
  sponsors    TournamentSponsor[]

  @@unique([organizerId, slug])
  // Una sola Apertura, un solo Clausura y una sola fase final por temporada.
  @@unique([seasonId, seasonStage])
}

// Una temporada al estilo Liga 1 (especificación 012): agrupa torneos independientes (Apertura,
// Clausura y fase final) jugados por los mismos equipos. La tabla General, los campeones y el
// estado no se guardan: salen de los torneos.
model Season {
  id          String    @id @default(cuid())
  name        String
  organizerId String
  // Segundo tramo de la URL pública (cupamateur.com/{organizerSlug}/{slug}). Comparte el espacio de
  // nombres con los torneos del organizador: los generadores de slugs revisan las dos tablas.
  slug        String
  finalFormat String // "llaves" | "liguilla" | "ninguna"
  finalTeams  Int? // cuántos de la General pasan a la fase final; null si finalFormat = "ninguna"
  // Eliminada: se oculta y sus torneos quedan desvinculados (no se borran). Null = activa.
  deletedAt   DateTime?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  organizer   User         @relation(fields: [organizerId], references: [id])
  tournaments Tournament[]

  @@unique([organizerId, slug])
  @@index([organizerId])
}

// Un auspiciador (marca/negocio) que patrocina uno o más torneos. Venta gestionada por el
// equipo comercial, no self-service: solo un admin crea y vincula sponsors (ver
// pendientes-y-decisiones.md, decisión 14, y docs/canvases.md). Alcance del MVP: solo mostrar
// la marca (nombre, logo, link) en la convocatoria pública del torneo — sin paquetes, pagos
// ni reportes de alcance todavía.
model Sponsor {
  id        String   @id @default(cuid())
  name      String
  logoUrl   String?
  website   String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  tournaments TournamentSponsor[]
}

// Vincula un sponsor a un torneo puntual (un sponsor puede auspiciar varios torneos, y un
// torneo puede tener varios sponsors).
model TournamentSponsor {
  id           String   @id @default(cuid())
  tournamentId String
  sponsorId    String
  createdAt    DateTime @default(now())

  tournament Tournament @relation(fields: [tournamentId], references: [id], onDelete: Cascade)
  sponsor    Sponsor    @relation(fields: [sponsorId], references: [id], onDelete: Cascade)

  @@unique([tournamentId, sponsorId])
}

model TournamentTeam {
  id           String   @id @default(cuid())
  tournamentId String
  clubId       String
  groupName    String?
  enrolledAt   DateTime @default(now())

  tournament Tournament @relation(fields: [tournamentId], references: [id], onDelete: Cascade)
  club       Club       @relation(fields: [clubId], references: [id], onDelete: Cascade)

  @@unique([tournamentId, clubId])
  @@index([clubId])
}

// Solicitud de un club para entrar a un torneo (kind "request") o invitación del
// organizador a un club (kind "invite"). Aceptar crea el TournamentTeam.
// Una fila por par (torneo, club): pedir de nuevo tras un rechazo la reabre.
model TournamentRequest {
  id           String    @id @default(cuid())
  tournamentId String
  clubId       String
  kind         String // "request" | "invite"
  status       String    @default("pending") // pending | accepted | declined | cancelled
  createdById  String
  createdAt    DateTime  @default(now())
  resolvedAt   DateTime?

  tournament Tournament @relation(fields: [tournamentId], references: [id], onDelete: Cascade)
  club       Club       @relation(fields: [clubId], references: [id], onDelete: Cascade)
  createdBy  User       @relation(fields: [createdById], references: [id])

  @@unique([tournamentId, clubId])
  @@index([clubId, status])
}

// ─── Matches & Events ───────────────────────────────────────────

model Match {
  id                  String    @id @default(cuid())
  tournamentId        String
  // "Por definir": null hasta que se conoce el ganador del cruce anterior (solo pasa en
  // un cuadro de eliminación). En liga/grupos siempre vienen los dos desde que se crea.
  homeTeamId          String?
  awayTeamId          String?
  homeScore           Int?
  awayScore           Int?
  status              String    @default("programado")
  date                DateTime
  time                String
  location            String
  matchday            Int
  groupName           String?
  // Cuándo se dio inicio al partido (pasó a "en_curso"). El cronómetro en vivo se calcula
  // desde acá, así sobrevive a recargar la página.
  startedAt           DateTime?
  // Los dos tiempos (especificación 010): "primer_tiempo" | "descanso" | "segundo_tiempo".
  // null = un partido que empezó antes de que existieran (sigue con un solo cronómetro) o que
  // todavía no empezó. `firstHalfEndedAt` congela el cronómetro en el descanso y
  // `secondHalfStartedAt` marca desde dónde corre el segundo tiempo.
  period              String?
  firstHalfEndedAt    DateTime?
  secondHalfStartedAt DateTime?
  // Cuándo terminó (pasó a "finalizado"); null mientras no. De ahí sale el cierre de la ventana de la mesa.
  finishedAt          DateTime?
  createdAt           DateTime  @default(now())
  updatedAt           DateTime  @updatedAt

  // ─── Cuadro de eliminación (especificación 007) ────────────────────────────
  // A qué partido y de qué lado pasa quien gane este (null fuera de un cuadro).
  nextMatchId      String?
  nextMatchSlot    String? // "home" | "away"
  // ¿Puede este partido terminar empatado? No, si es parte de un cuadro de eliminación:
  // ahí, si sigue empatado, se juega tiempo extra y penales en vez de guardarse así.
  decisive         Boolean @default(false)
  winnerTeamId     String? // quien avanza (los penales no lo dice el marcador)
  phase            String  @default("regulacion") // regulacion | tiempo_extra | penales
  penaltyHomeScore Int?
  penaltyAwayScore Int?

  tournament Tournament    @relation(fields: [tournamentId], references: [id], onDelete: Cascade)
  homeTeam   Club?         @relation("HomeTeam", fields: [homeTeamId], references: [id])
  awayTeam   Club?         @relation("AwayTeam", fields: [awayTeamId], references: [id])
  events     MatchEvent[]
  lineups    MatchLineup[]

  nextMatch Match?  @relation("MatchBracket", fields: [nextMatchId], references: [id], onDelete: SetNull, onUpdate: NoAction)
  feedsInto Match[] @relation("MatchBracket")

  @@index([tournamentId, status])
  @@index([homeTeamId])
  @@index([awayTeamId])
}

// Los titulares que un club definió para un partido puntual (ver /club/torneos/:id/titulares).
// No toca matchesPlayed ni assists de PlayerStats: esos se cuentan cuando el partido termina,
// no cuando se arma la alineación — ver pendientes-y-decisiones.md.
model MatchLineup {
  id        String   @id @default(cuid())
  matchId   String
  clubId    String
  playerId  String
  createdAt DateTime @default(now())

  match  Match         @relation(fields: [matchId], references: [id], onDelete: Cascade)
  club   Club          @relation(fields: [clubId], references: [id], onDelete: Cascade)
  player PlayerProfile @relation(fields: [playerId], references: [id], onDelete: Cascade)

  @@unique([matchId, playerId])
}

model MatchEvent {
  id           String   @id @default(cuid())
  matchId      String
  type         String
  minute       Int
  playerId     String?
  teamId       String?
  detail       String?
  createdAt    DateTime @default(now())
  // En qué fase ocurrió (solo distinto de "regulacion" en un partido decisivo). "scored"
  // solo aplica al tipo "penal_definicion": ¿convirtió o falló ese intento?
  phase        String   @default("regulacion")
  scored       Boolean?
  // En qué tiempo ocurrió (1 o 2); null en un partido sin tiempos. Es lo que separa la
  // cronología en "Segundo tiempo": el minuto solo no alcanza (el tiempo agregado del primero
  // puede pasar del minuto en que arranca el segundo).
  half         Int?
  // Quién registró la jugada (organizador, admin o mesa); null en las anteriores a la especificación 011.
  recordedById String?
  // Solo en un cambio ("sustitucion"): quien entra. `playerId` es quien sale.
  playerInId   String?

  match      Match          @relation(fields: [matchId], references: [id], onDelete: Cascade)
  player     PlayerProfile? @relation("EventPlayer", fields: [playerId], references: [id])
  playerIn   PlayerProfile? @relation("SubstitutionIn", fields: [playerInId], references: [id], onDelete: SetNull)
  recordedBy User?          @relation("EventRecordedBy", fields: [recordedById], references: [id], onDelete: SetNull)

  @@index([matchId])
  @@index([playerId])
}

// La cuota mensual estándar de un club y el día del mes en que vence (especificación 015). Sin fila = todavía no definió cuota.
model ClubFeeSettings {
  clubId     String   @id
  // En soles, con dos decimales.
  monthlyFee Decimal  @default(0) @db.Decimal(10, 2)
  // Día del mes (1 a 28) en que vence cada cuota.
  dueDay     Int      @default(5)
  updatedAt  DateTime @updatedAt

  club Club @relation(fields: [clubId], references: [id], onDelete: Cascade)
}

// La cuota de un jugador (especificación 015). `monthlyFeeOverride` null = paga la estándar del club; 0 = no paga.
// `startMonth` ("AAAA-MM") es el primer mes que se le cobra.
model PlayerFeeSetting {
  playerId           String   @id
  // El club al que corresponde: una ficha libre que pasa a otro club arranca de cero, sin arrastrar el monto del anterior.
  clubId             String
  monthlyFeeOverride Decimal? @db.Decimal(10, 2)
  startMonth         String
  updatedAt          DateTime @updatedAt

  player PlayerProfile @relation(fields: [playerId], references: [id], onDelete: Cascade)
}

// Un mes de cuota de un jugador en un club (especificación 015). Guarda lo que se debía al generarse, así que cambiar
// la cuota del club o el monto propio después no reescribe los meses ya generados.
model MemberFee {
  id        String   @id @default(cuid())
  playerId  String
  clubId    String
  // "AAAA-MM", mes calendario en hora de Perú.
  month     String
  amountDue Decimal  @db.Decimal(10, 2)
  createdAt DateTime @default(now())

  player   PlayerProfile @relation(fields: [playerId], references: [id], onDelete: Cascade)
  club     Club          @relation(fields: [clubId], references: [id], onDelete: Cascade)
  payments FeePayment[]

  @@unique([playerId, clubId, month])
  @@index([clubId, month])
}

// Un abono a un mes. Nunca se borra: se anula (`voidedAt`), para conservar quién cobró, cuándo y quién lo deshizo.
model FeePayment {
  id          String    @id @default(cuid())
  feeId       String
  amount      Decimal   @db.Decimal(10, 2)
  paidAt      DateTime  @default(now())
  createdById String
  voidedAt    DateTime?
  voidedById  String?

  fee MemberFee @relation(fields: [feeId], references: [id], onDelete: Cascade)

  @@index([feeId])
}

// Un lugar de entrenamiento del club (especificación 015): "Colegio Perú Suizo", "Parque de las Américas"... Es del club, no
// de una persona: el delegado principal y los co-delegados usan la misma lista. Uno con sesiones no se borra: se archiva.
model TrainingPlace {
  id         String    @id @default(cuid())
  clubId     String
  name       String
  address    String?
  archivedAt DateTime?
  createdAt  DateTime  @default(now())

  club      Club               @relation(fields: [clubId], references: [id], onDelete: Cascade)
  schedules TrainingSchedule[]
  sessions  TrainingSession[]

  @@index([clubId])
}

// Un horario semanal de entrenamiento: de él salen las sesiones. `categoryId` null = todo el club.
model TrainingSchedule {
  id          String   @id @default(cuid())
  clubId      String
  categoryId  String?
  // 0 = domingo ... 6 = sábado, como `Date.getDay()`.
  weekday     Int
  // "HH:MM" en hora de Perú.
  startTime   String
  durationMin Int
  placeId     String
  active      Boolean  @default(true)
  createdAt   DateTime @default(now())

  club     Club              @relation(fields: [clubId], references: [id], onDelete: Cascade)
  category TeamCategory?     @relation(fields: [categoryId], references: [id], onDelete: Cascade)
  place    TrainingPlace     @relation(fields: [placeId], references: [id])
  sessions TrainingSession[]

  @@index([clubId])
}

// Un entrenamiento concreto. Sale de un horario (`scheduleId`) o se crea suelto (null). `startsAt` es el instante real (UTC).
//   programada   va a ocurrir o ya ocurrió
//   cancelada    no se hizo: no cuenta para promedios y no se pasa lista
// `movedManually` evita que editar el horario pise una sesión que el delegado ya movió a mano.
model TrainingSession {
  id            String   @id @default(cuid())
  clubId        String
  categoryId    String?
  scheduleId    String?
  startsAt      DateTime
  durationMin   Int
  placeId       String
  status        String   @default("programada")
  movedManually Boolean  @default(false)
  createdAt     DateTime @default(now())

  club        Club              @relation(fields: [clubId], references: [id], onDelete: Cascade)
  category    TeamCategory?     @relation(fields: [categoryId], references: [id], onDelete: Cascade)
  schedule    TrainingSchedule? @relation(fields: [scheduleId], references: [id], onDelete: SetNull)
  place       TrainingPlace     @relation(fields: [placeId], references: [id])
  attendances Attendance[]

  @@unique([scheduleId, startsAt])
  @@index([clubId, startsAt])
}

// La asistencia de un jugador a una sesión: presente, ausente o justificado. Sin fila = sin marcar.
model Attendance {
  id         String   @id @default(cuid())
  sessionId  String
  playerId   String
  status     String
  markedById String
  markedAt   DateTime @default(now())

  session TrainingSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  player  PlayerProfile   @relation(fields: [playerId], references: [id], onDelete: Cascade)

  @@unique([sessionId, playerId])
  @@index([playerId])
}
